// Cloudflare Worker "watershed-ai": serve la pagina statica in site/
// (generata da scripts/build_satellite_3d_site.py). Deploy: npx wrangler deploy
{
  "name": "watershed-ai",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./site"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
